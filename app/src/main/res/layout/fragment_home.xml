<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/Ui_Color" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/profile" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/user" android:contentDescription="@string/local_profile" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/app_name" android:padding="12dp" android:textSize="26sp" android:textColor="@color/white" />
        <TextView android:id="@+id/totalCrypto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white" />
    </LinearLayout>
    <TextView android:id="@+id/enforcementStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:textColor="@color/white" android:accessibilityLiveRegion="polite" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
        <Button android:id="@+id/permissionSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/blocking_access" />
        <Button android:id="@+id/usageSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/usage_access" />
        <Button android:id="@+id/claimReward" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reward" />
        <Button android:id="@+id/help" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/help_instructions" />
        <Button android:id="@+id/privacy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/privacy_control" />
        <Button android:id="@+id/history" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/history" />
      </LinearLayout>
    </HorizontalScrollView>
    <com.google.android.material.tabs.TabLayout android:id="@+id/tab_layout" android:layout_width="match_parent" android:layout_height="wrap_content" app:tabTextColor="@color/white" app:tabIndicatorColor="@color/white" />
    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/view_pager" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
</layout>
