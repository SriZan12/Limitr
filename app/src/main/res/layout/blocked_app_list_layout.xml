<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/Ui_Color"
        tools:context=".ui.home.blockedApps.BlockedApps">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/blockedAppRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:padding="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/noApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_apps_are_blocked"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:fontFamily="@font/acme"
            android:visibility="gone"
            android:gravity="center"
            android:textSize="20sp"
            android:layout_margin="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/blockedAppRecycler" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>