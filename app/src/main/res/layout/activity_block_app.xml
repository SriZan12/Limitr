<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/Ui_Color">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
    <ImageView android:id="@+id/appIcon" android:layout_width="72dp" android:layout_height="72dp" android:importantForAccessibility="no" />
    <TextView android:id="@+id/appName" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="24sp" android:textColor="@color/white" android:padding="12dp" />
    <TextView android:id="@+id/timerText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="20sp" android:padding="8dp" />
    <TextView android:id="@+id/intervalText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:padding="8dp" />
    <TextView android:id="@+id/enforcementStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:padding="8dp" />
    <Button android:id="@+id/setTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/set_timer" />
    <Button android:id="@+id/setInterval" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/set_interval" />
    <androidx.appcompat.widget.SwitchCompat android:id="@+id/blockNotification" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:textColor="@color/white" android:text="@string/hide_notifications" />
    <Button android:id="@+id/unblockCrypto" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/unblock_crypto" />
    <Button android:id="@+id/unBlockApp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/stop_session" />
    <Button android:id="@+id/permissionSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/blocking_access" />
    <Button android:id="@+id/sessionNotifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/session_notifications" />
</LinearLayout>
</ScrollView>
</layout>
