<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/white">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/Ui_Color" android:fontFamily="@font/acme" android:gravity="center" android:padding="12dp" android:text="@string/reward" android:textColor="@color/white" android:textSize="20sp" />
        <ImageView android:layout_width="60dp" android:layout_height="60dp" android:layout_marginTop="24dp" android:src="@drawable/crypto" android:importantForAccessibility="no" />
        <TextView android:id="@+id/cryptoText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/acme" android:padding="12dp" android:textColor="@color/black" android:textSize="24sp" />
        <TextView android:id="@+id/firstLoginText" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/acme" android:gravity="center" android:padding="8dp" android:textColor="@color/black" android:textSize="20sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/claimReward" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="24dp" android:background="@drawable/textview_design" android:fontFamily="@font/acme" android:text="@string/reward" android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
