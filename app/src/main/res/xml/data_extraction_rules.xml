<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="My SharePref.xml" />
        <include domain="sharedpref" path="local_profile.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="My SharePref.xml" />
        <include domain="sharedpref" path="local_profile.xml" />
    </device-transfer>
</data-extraction-rules>
